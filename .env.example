# Only needed for `office-agent triage run --use-llm` (draft replies via Claude).
# kb search and rule-based triage work with none of these set.
ANTHROPIC_API_KEY=

# Only needed for `office-agent triage run --source imap` (Stage 1: reads
# HELLFIRE's own mailbox over IMAP, e.g. a Gmail app password). A generic
# per-client Gmail/Outlook OAuth connector is Stage 2 scope.
OFFICE_AGENT_IMAP_HOST=
OFFICE_AGENT_IMAP_USER=
OFFICE_AGENT_IMAP_PASSWORD=
